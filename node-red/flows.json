    "payloadType": "json",
    "x": 160,
    "y": 120,
    "wires": [["setHeaders1"]]
  },
  {
    "id": "setHeaders1",
    "type": "function",
    "z": "flow1",
    "name": "Content-Type セット",
    "func": "msg.headers = { 'Content-Type': 'application/json' };\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 370,
    "y": 120,
    "wires": [["httpRequest1"]]
  },
  {
    "id": "httpRequest1",
    "type": "http request",
    "z": "flow1",
    "name": "POST /sensors",
    "method": "POST",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "http://sensor-api:3000/sensors",
    "tls": "",
    "persist": false,
    "proxy": "",
    "authType": "",
    "x": 580,
    "y": 120,
    "wires": [["debug1"]]
  },
  {
    "id": "debug1",
    "type": "debug",
    "z": "flow1",
    "name": "レスポンス確認",
